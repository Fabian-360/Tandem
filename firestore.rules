rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mitglied = eine der beiden UIDs in households/tandem.members
    function isMember() {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/households/tandem).data.members;
    }
    // Gemeinsame Daten: nur ihr beide
    match /households/tandem {
      allow read: if isMember();
      allow write: if false; // Mitglieder nur in der Firebase-Konsole pflegen
    }
    match /households/tandem/{rest=**} {
      allow read, write: if isMember();
    }
    // Private Daten (Tagebuch, Notizen, Wunschliste, private Ausgaben): nur der Besitzer
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
